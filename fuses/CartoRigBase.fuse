-- CartoRig Base Map compositor: ocean plus optional land/line mattes.
-- Missing geographic mattes are not fabricated. The renderer supplies them.
FuRegisterClass('CartoRigBase',CT_Tool,{
  REGS_Name='CartoRig Base Map',
  REGS_Category='CartoRig\\Map Objects',
  REGS_OpIconString='CRB',
  REGS_OpDescription='Ocean surface, transparent overlay, and independently animated ocean layer',
  REG_NoMotionBlurCtrls=true,
})
local function v(input,req)
  local x=input:GetValue(req)
  local n=tonumber(type(x)=='table' and x.Value or x)
  if not n or n~=n then return 0 end
  return math.max(0,math.min(1,n))
end
function Create()
  self:AddControlPage('Control')
  InDisplayMode=self:AddInput('Display Mode','DisplayMode',{
    LINKID_DataType='Number',INPID_InputControl='ComboControl',INP_Integer=true,INP_Default=0,
    {CCS_AddString='Full Map'},{CCS_AddString='Transparent Overlay'},
  })
  InOceanR=self:AddInput('Ocean Red','OceanRed',{
    LINKID_DataType='Number',INPID_InputControl='ColorControl',INP_Default=16/255,
    INP_MinScale=0,INP_MaxScale=1,IC_ControlGroup=31,IC_ControlID=0,
  })
  InOceanG=self:AddInput('Ocean Green','OceanGreen',{
    LINKID_DataType='Number',INPID_InputControl='ColorControl',INP_Default=40/255,
    INP_MinScale=0,INP_MaxScale=1,IC_ControlGroup=31,IC_ControlID=1,
  })
  InOceanB=self:AddInput('Ocean Blue','OceanBlue',{
    LINKID_DataType='Number',INPID_InputControl='ColorControl',INP_Default=60/255,
    INP_MinScale=0,INP_MaxScale=1,IC_ControlGroup=31,IC_ControlID=2,
  })
  InBaseOpacity=self:AddInput('Base Opacity','BaseOpacity',{
    LINKID_DataType='Number',INPID_InputControl='SliderControl',INP_Default=1,
    INP_MinScale=0,INP_MaxScale=1,INP_MinAllowed=0,INP_MaxAllowed=1,
  })
  InOceanLayerOpacity=self:AddInput('Ocean Layer Opacity','OceanLayerOpacity',{
    LINKID_DataType='Number',INPID_InputControl='SliderControl',INP_Default=1,
    INP_MinScale=0,INP_MaxScale=1,INP_MinAllowed=0,INP_MaxAllowed=1,
  })
  -- Land/coastline/admin borders each have independent RGBA color and opacity.
  -- Source masks must be white, premultiplied geographic coverage.
  LayerInputs={}
  local definitions={
    {'Land','Land',57/255,76/255,89/255,33},
    {'Coastline','Coastline',181/255,193/255,204/255,34},
    {'CountryBorders','Country Borders',150/255,170/255,185/255,35},
    {'StateBorders','State Borders',130/255,149/255,164/255,36},
  }
  for _,row in ipairs(definitions) do
    local id,label=row[1],row[2]
    local color={}
    for i,component in ipairs({'Red','Green','Blue'}) do
      color[i]=self:AddInput(label..' '..component,id..component,{
        LINKID_DataType='Number',INPID_InputControl='ColorControl',
        INP_Default=row[i+2],INP_MinScale=0,INP_MaxScale=1,
        IC_ControlGroup=row[6],IC_ControlID=i-1,
      })
    end
    local opacity=self:AddInput(label..' Layer Opacity',id..'LayerOpacity',{
      LINKID_DataType='Number',INPID_InputControl='SliderControl',
      INP_Default=1,INP_MinScale=0,INP_MaxScale=1,INP_MinAllowed=0,INP_MaxAllowed=1,
    })
    local matte=self:AddInput(label..' White Matte',id..'Input',{
      LINKID_DataType='Image',INP_Required=false,
    })
    LayerInputs[#LayerInputs+1]={id=id,colors=color,opacity=opacity,matte=matte}
  end
  self:AddControlPage('Motion')
  for _,layer in ipairs(LayerInputs) do
    self:CloneInput(layer.opacity,'Motion'..layer.id..'LayerOpacity',{
      INP_DoNotifyChanged=false,INP_InteractivePassive=true,
    })
  end
  self:CloneInput(InOceanLayerOpacity,'MotionOceanLayerOpacity',{
    INP_DoNotifyChanged=false,INP_InteractivePassive=true,
  })
  InImage=self:AddInput('White Base Surface','Input',{
    LINKID_DataType='Image',LINK_Main=1,INP_Required=true,
  })
  OutImage=self:AddOutput('Output','Output',{LINKID_DataType='Image',LINK_Main=1})
end
function Process(req)
  local img=InImage:GetValue(req)
  if not img then OutImage:Set(req,nil);return end
  local mode=InDisplayMode:GetValue(req)
  mode=tonumber(type(mode)=='table' and mode.Value or mode) or 0
  local opacity=(mode==1) and 0 or v(InBaseOpacity,req)*v(InOceanLayerOpacity,req)
  local out=img:Copy()
  out:Gain(v(InOceanR,req)*opacity,v(InOceanG,req)*opacity,
           v(InOceanB,req)*opacity,opacity)
  if mode~=1 then
    for _,layer in ipairs(LayerInputs) do
      local matte=layer.matte:GetValue(req)
      if matte then
        local fraction=v(layer.opacity,req)*v(InBaseOpacity,req)
        if fraction>0 then
          local styled=matte:Copy()
          styled:Gain(v(layer.colors[1],req)*fraction,
            v(layer.colors[2],req)*fraction,
            v(layer.colors[3],req)*fraction,fraction)
          out:Merge(styled,{MO_ApplyMode='Merge',MO_ApplyOperator='Over'})
        end
      end
    end
  end
  OutImage:Set(req,out)
end
